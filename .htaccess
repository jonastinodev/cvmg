# ==========================================================================
# CVMG — configuration Apache (racine du site)
# ==========================================================================

# --- Page d'accueil ---
# On sert accueil.html à la racine du domaine (et NON l'ancien index.html,
# qui est le scanner CIN historique, hors sujet pour le référencement).
DirectoryIndex accueil.html index.php index.html

# --- En-têtes de sécurité ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # À activer UNIQUEMENT une fois le site servi en HTTPS de bout en bout :
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# --- Compression (réduit fortement le poids texte) ---
# AddOutputFilterByType dépend de mod_filter, pas seulement de mod_deflate :
# sur cette install XAMPP, mod_filter est désactivé dans httpd.conf, donc le
# double IfModule est nécessaire pour ne pas casser le site si l'un des deux
# modules manque.
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
  </IfModule>
</IfModule>

# --- Cache navigateur ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css              "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 month"
  ExpiresByType image/png             "access plus 1 month"
  ExpiresByType image/jpeg            "access plus 1 month"
  ExpiresByType text/html             "access plus 0 seconds"
</IfModule>

# --- Interdire l'accès direct aux fichiers sensibles ---
# (config.php et session.php restent inclus côté serveur : le blocage ne
#  concerne que l'accès HTTP direct depuis un navigateur.)
<Files "config.php">
  Require all denied
</Files>
<Files "session.php">
  Require all denied
</Files>
<Files "diag.php">
  Require all denied
</Files>
<Files "test-pdf.php">
  Require all denied
</Files>
<FilesMatch "\.(sql|lock|md)$">
  Require all denied
</FilesMatch>

# --- Pages d'erreur ---
ErrorDocument 404 /404.html
